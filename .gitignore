# -------------------------
.vuepress/dist/
.temp/

# -------------------------
# Framework-Specific Generated Files
# -------------------------
.nuxt/
.output/
.svelte-kit/

# -------------------------
# Local Tool State
# -------------------------
.eslintcache
.stylelintcache
.cache/
.parcel-cache/

# -------------------------
# OS / Editor Swap Files
# -------------------------
*.swp
*.swo